# Copy to .env and fill in. `.env` is git-ignored.

# Flask session signing key — any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string from Neon (or any Postgres host).
# Neon: Dashboard → your project → Connection string → "psql".
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudinary credentials for restaurant image uploads.
# Cloudinary: Dashboard → "API Keys" → copy the "API environment variable" value.
# Optional — if unset, signup works but uses the bundled placeholder images.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
